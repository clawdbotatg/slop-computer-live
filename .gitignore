# Out-of-band tooling lives in ~/clawd/slop-scripts (its own repo).
# Anything that lands here is local scratch and should not be committed.
scripts/

# Relay's local password file — generated at runtime, dev-only path.
.slop-data/

# slop-broadcast env contains the MediaMTX publish password — lives on
# the EC2 box only, never committed. The .env.example next to it shows
# the schema.
deploy/slop-broadcast.env

# Music + user-uploaded files live on the box (`/var/lib/slop-relay/{music,files}`),
# served by the relay. Never commit binary blobs into the repo.
packages/nextjs/public/music/

# TypeScript incremental build cache — regenerated on every `tsc`,
# should never land in git.
*.tsbuildinfo

# Icon generator local cache (full-res PNGs from OpenAI). Published icons
# live in packages/nextjs/public/icons/ — those ARE committed.
packages/icon-gen/out/

# browser-host warmup cookies — generated locally via `yarn warmup`, scp'd
# to prod once. Contains Google's bot-detection cookies (NID/SOCS/CONSENT)
# from the warmup session — keep out of git.
packages/browser-host/cookies.json
