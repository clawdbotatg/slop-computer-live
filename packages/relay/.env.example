# slop-computer-live relay env vars. Copy to .env for local dev.

PORT=8081
HOST=0.0.0.0

# Browser origins allowed to call the relay (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Comma-separated lowercase wallet addresses with host privileges.
ADMIN_ADDRESSES=

# Domain SIWE messages must match (no scheme; matches window.location.host).
ADMIN_DOMAIN=localhost:3001

# Shared password for non-wallet guests. Rotate per show.
GUEST_PASSWORD=

# Random secret used to sign session cookies.
SIWE_SESSION_SECRET=

# Session lifetime in seconds (default 24h).
SESSION_TTL_SECONDS=86400

# Alchemy key for SIWE smart-wallet (ERC-1271) signature verification.
ALCHEMY_API_KEY=<get free key at https://dashboard.alchemy.com>

# RTMP ingress URL returned by /admin/start (Phase 6 wires this to MediaMTX).
MEDIAMTX_RTMP_INGRESS_URL=rtmp://localhost:1935/live

# Where MediaMTX writes session recordings. Must match `recordPath` in
# deploy/mediamtx.yml; the relay's /admin/finalize scans this dir.
RECORDINGS_DIR=/home/ubuntu/recordings

# bgipfs CLI for pinning recordings to IPFS. Defaults assume `bgipfs` is on
# PATH and credentials live at $HOME/.bgipfs/credentials.json.
BGIPFS_BIN=bgipfs
BGIPFS_CONFIG=

# Jamendo API credentials for the SLOPAMP music player's genre playlists.
# Without these, /v1/music/genre/<g>/playlist returns 502 and the player
# can't load any audio. Register a free app at https://devportal.jamendo.com/
# to get a client id (the secret is unused right now but reserved for OAuth).
JAMENDO_CLIENT_ID=
JAMENDO_CLIENT_SECRET=

# Anthropic API key — powers the wallet-tx AI summarizer AND the
# host-only Guest Research dossier app (/v1/guest-research). Without
# this set, the wallet falls back to a raw-calldata summary and the
# Research app returns a stub explaining what to set. Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-4-7.
ANTHROPIC_RESEARCH_MODEL=

# (Optional) Twitter / X API credentials for the Research app. Not used
# directly yet — the research dossier relies on Anthropic's web_search
# tool, which is enough for public-tweet discovery. Reserved for a
# future authenticated-feed fetch. Keep in .env (NEVER commit).
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
