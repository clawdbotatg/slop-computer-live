# slop-computer-live relay env vars. Copy to .env for local dev.

PORT=8081
HOST=0.0.0.0

# Browser origins allowed to call the relay (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Comma-separated lowercase wallet addresses with host privileges.
ADMIN_ADDRESSES=

# Domain SIWE messages must match (no scheme; matches window.location.host).
ADMIN_DOMAIN=localhost:3001

# Shared password for non-wallet guests. Rotate per show.
GUEST_PASSWORD=

# Random secret used to sign session cookies.
SIWE_SESSION_SECRET=

# Session lifetime in seconds (default 24h).
SESSION_TTL_SECONDS=86400

# Alchemy key for SIWE smart-wallet (ERC-1271) signature verification.
ALCHEMY_API_KEY=<get free key at https://dashboard.alchemy.com>

# RTMP ingress URL returned by /admin/start (Phase 6 wires this to MediaMTX).
MEDIAMTX_RTMP_INGRESS_URL=rtmp://localhost:1935/live

# Where MediaMTX writes session recordings. Must match `recordPath` in
# deploy/mediamtx.yml; the relay's /admin/finalize scans this dir.
RECORDINGS_DIR=/home/ubuntu/recordings

# Path to a clawd-clipper checkout on this box. When set, /admin/generate-clips
# spawns it (`tsx src/index.ts <slug> --vertical --publish`) to cut the 9:16
# clips + tweets, pin them to bgipfs, and produce an updated manifest CID.
# Unset → the route 501s (clips stay a local/manual flow). See ops/clips.md.
CLIPPER_DIR=

# bgipfs CLI for pinning recordings to IPFS. Defaults assume `bgipfs` is on
# PATH and credentials live at $HOME/.bgipfs/credentials.json.
BGIPFS_BIN=bgipfs
BGIPFS_CONFIG=

# Jamendo API credentials for the SLOPAMP music player's genre playlists.
# Without these, /v1/music/genre/<g>/playlist returns 502 and the player
# can't load any audio. Register a free app at https://devportal.jamendo.com/
# to get a client id (the secret is unused right now but reserved for OAuth).
JAMENDO_CLIENT_ID=
JAMENDO_CLIENT_SECRET=

# Anthropic API key — powers the wallet-tx AI summarizer AND the
# host-only Guest Research dossier app (/v1/guest-research). Without
# this set, the wallet falls back to a raw-calldata summary and the
# Research app returns a stub explaining what to set. Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-4-7.
ANTHROPIC_RESEARCH_MODEL=

# Browser-host admin ingress — used by the relay to tell the browser-host
# to destroy a specific tab (on `browser_close`) and to close a whole
# room context (on hibernation). Without this set, both notifications
# are no-ops and host tabs only get cleaned up via subscriber WS-close +
# 30s linger, which leaves zombies when a peer's socket lingers.
# In prod: http://localhost:8090 (browser-host binds to localhost).
BROWSER_HOST_INGRESS_URL=
# Optional auth; only checked if the browser-host has the matching
# RELAY_TX_BROADCAST_SECRET set (today neither side requires it).
BROWSER_HOST_INGRESS_SECRET=

# (Optional) Twitter / X API credentials for the Research app. Not used
# directly yet — the research dossier relies on Anthropic's web_search
# tool, which is enough for public-tweet discovery. Reserved for a
# future authenticated-feed fetch. Keep in .env (NEVER commit).
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# --- AI wallet (ported from slop-computer-ai-wallet) ------------------------
# The conversational wallet's LLM runs through Bankr's OpenAI-compatible
# gateway. SLOP_COMPUTER_AI_WALLET is the bearer token for it. Missing →
# the wallet chat returns a clear "not configured" message.
SLOP_COMPUTER_AI_WALLET=
# Override the gateway base URL / model if needed (defaults are fine).
AI_WALLET_LLM_BASE_URL=https://llm.bankr.bot/v1
AI_WALLET_LLM_MODEL=claude-opus-4.7
# Zerion powers portfolio + transaction history; LI.FI powers swap /
# bridge / DeFi-zap routing. Both required for a fully working wallet.
ZERION_API_KEY=
LIFI_API_KEY=

# --- Apple Pay → personal-wallet on-ramp (Coinbase Onramp; docs §13) --------
# CDP Secret API key used to mint single-use Coinbase Onramp session tokens
# (Apple Pay → ETH on Base, straight into the user's personal wallet). Create
# at portal.cdp.coinbase.com: CDP_API_KEY_ID is the key UUID, CDP_API_KEY_SECRET
# is its base64 Ed25519 secret. Server-only — NEVER commit. Unset → the
# "Add funds with Apple Pay" button reports "not set up yet" and /onramp/session 503s.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
