# slop-computer-live relay env vars. Copy to .env for local dev.

PORT=8080
HOST=0.0.0.0

# Browser origins allowed to call the relay (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Comma-separated lowercase wallet addresses with host privileges.
ADMIN_ADDRESSES=

# Domain SIWE messages must match (no scheme; matches window.location.host).
ADMIN_DOMAIN=localhost:3001

# Shared password for non-wallet guests. Rotate per show.
GUEST_PASSWORD=

# Random secret used to sign session cookies.
SIWE_SESSION_SECRET=

# Session lifetime in seconds (default 24h).
SESSION_TTL_SECONDS=86400

# Alchemy key for SIWE smart-wallet (ERC-1271) signature verification.
ALCHEMY_API_KEY=<get free key at https://dashboard.alchemy.com>

# RTMP ingress URL returned by /admin/start (Phase 6 wires this to MediaMTX).
MEDIAMTX_RTMP_INGRESS_URL=rtmp://localhost:1935/live
