# Template for slop-computer-live Next.js env vars.
#
# Copy to .env.local and fill in real values. NEXT_PUBLIC_* vars are INLINED
# at build time, and `ops/deploy.sh` builds Next.js LOCALLY (not on prod) — so
# the production values must live in *this machine's* .env.local, NOT the EC2
# systemd unit (which never reaches a local `next build`). For a prod build,
# point the relay/browser/HLS URLs at the public hosts, e.g.:
#   NEXT_PUBLIC_RELAY_HTTP_URL=https://live.slop.computer
#   NEXT_PUBLIC_RELAY_URL=wss://live.slop.computer/signal
#   NEXT_PUBLIC_BROWSER_HOST_URL=wss://live.slop.computer/browser
# Leaving the localhost defaults below ships a bundle that fetches the
# visitor's own machine ("Failed to fetch"); deploy.sh now hard-fails on that.

NEXT_PUBLIC_ALCHEMY_API_KEY=<get free key at https://dashboard.alchemy.com>
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Address of the deployed SlopComputerFrontpage contract (mainnet).
NEXT_PUBLIC_FRONTPAGE_ADDRESS=

# Relay base URL (HTTP). The browser hits /auth/siwe, /admin/start etc here.
NEXT_PUBLIC_RELAY_HTTP_URL=http://localhost:8080

# Relay WebSocket URL (signaling).
NEXT_PUBLIC_RELAY_URL=ws://localhost:8080/signal

# Browser-host WebSocket URL. The shared-browser canvas connects here for
# pixel streaming + input forwarding. In production this is the same domain
# as the relay, on the /browser path (Caddy reverse-proxies to port 8090).
NEXT_PUBLIC_BROWSER_HOST_URL=ws://localhost:8090

# Public HLS URL for the audience player on `/`.
NEXT_PUBLIC_HLS_URL=
