+/// Load BFV params by Interfold preset name. Values for
+/// INSECURE_THRESHOLD_512 mirror interfold's
+/// crates/fhe-params/src/constants.rs `insecure_512::threshold`
+/// (degree 512, t = 100, moduli [0xffffee001, 0xffffc4001],
+/// error1_variance 3) — the preset the live Sepolia testnet registers
+/// as paramSet 0.
+#[wasm_bindgen]
+pub fn load_params_named(name: &str) -> ParamsHandle {
+    match name {
+        "SECURE_THRESHOLD_8192" => load_params(),
+        "INSECURE_THRESHOLD_512" => ParamsHandle {
+            inner: BfvParametersBuilder::new()
+                .set_degree(512)
+                .set_plaintext_modulus(100)
+                .set_moduli(&[0xffffee001, 0xffffc4001])
+                .set_error1_variance_str("3")
+                .unwrap_or_else(|error| panic!("invalid error1 variance: {error}"))
+                .build_arc()
+                .unwrap_or_else(|error| panic!("insecure-512 params build failed: {error}")),
+        },
+        other => panic!("unknown BFV preset: {other}"),
+    }
+}
