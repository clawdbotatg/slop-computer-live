# Bind
PORT=8090
HOST=0.0.0.0

# Allowed origins for the WS upgrade and HTTP /health (CSV).
CORS_ORIGINS=https://live.slop.computer,http://localhost:3000

# Address whose state the dapp should see when calls come through the
# injected provider. Defaults to vitalik.eth in src/config.ts; override for
# the smart-contract wallet once it's deployed.
IMPERSONATED_ADDRESS=0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045
CHAIN_ID=1

# Upstream RPC. Always use Alchemy in production — public RPCs will rate
# limit a busy session immediately.
ALCHEMY_API_KEY=

# Server viewport — pixel dimensions of the streamed Chrome window. Must
# match SERVER_W / SERVER_H in components/desktop/SharedBrowser.tsx.
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800

# Screencast tuning. Lower quality = smaller frames = less bandwidth per
# subscriber. everyNthFrame=1 sends every frame; 2 halves the rate.
SCREENCAST_QUALITY=60
SCREENCAST_EVERY_NTH_FRAME=1
SCREENCAST_MAX_WIDTH=1280
SCREENCAST_MAX_HEIGHT=800

# Optional: forward captured tx_request payloads to the relay so peers
# without a host subscription still see calldata. Leave unset for v1.
RELAY_TX_BROADCAST_URL=
RELAY_TX_BROADCAST_SECRET=
