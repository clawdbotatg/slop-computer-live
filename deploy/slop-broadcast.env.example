# slop-broadcast.service environment.
# Copy to /home/ubuntu/slop-computer-live/deploy/slop-broadcast.env
# and substitute real values. The env file is gitignored to avoid
# committing the publish password.

# Live room URL the broadcaster joins. Append godMode so it's a silent
# spectator. The relay's /admin/broadcast/start endpoint patches this
# value when switching shows.
SLOP_URL=https://live.slop.computer/jarjar?invite=__INVITE_PASSWORD__&godMode=__GOD_PASSWORD__

# Must match MEDIAMTX_PUBLISH_* in the relay env and the password
# substituted into deploy/mediamtx.yml.
MEDIAMTX_PUBLISH_USER=live
MEDIAMTX_PUBLISH_PASS=__MEDIAMTX_PUBLISH_PASS__

# Optional overrides (defaults shown):
# OUT_W=1280
# OUT_H=720
# FPS=30
# VBITRATE_K=4500
# ABITRATE_K=160
# AUTO_ENTER=1
