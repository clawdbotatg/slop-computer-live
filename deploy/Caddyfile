# slop-computer-live reverse proxy
#
# Replace `live.slop.computer` and `media.slop.computer` with your real
# domains. Caddy auto-fetches Let's Encrypt certs on first start
# (ports 80 + 443 must be reachable).
#
# WebSockets are upgraded automatically by `reverse_proxy`.

live.slop.computer {
    encode zstd gzip

    # Relay HTTP routes (SIWE auth, admin start/stop, TURN creds, agent
    # API, public apps catalog) and WS /signal endpoint. NOTE: port 8081 —
    # :8080 is owned by based-keno.
    #
    # `/files/*` and `/avatars/*` are PUBLIC download endpoints (no auth
    # gate; ids are unguessable). Without them here, dropped images load
    # as `<img src="…/files/<id>">` → Caddy → Next.js → 404 → broken icon.
    @relay path /signal* /auth/* /admin/* /turn/* /internal/* /v1/* /personal-wallet/* /onramp/* /apps /files/* /avatars/* /jamendo-music/* /uploaded-music/* /music/*
    reverse_proxy @relay localhost:8081

    # Browser-host: shared headless Chrome with frame streaming + impersonator.
    # Frontend connects to wss://live.slop.computer/browser/stream/<id>.
    handle_path /browser/* {
        reverse_proxy localhost:8090
    }

    # Next.js app
    reverse_proxy localhost:3000
}

media.slop.computer {
    encode zstd gzip
    # MediaMTX HLS output. The app speaks https://media.slop.computer/hls/live/index.m3u8
    # and MediaMTX serves at http://localhost:8888/live/index.m3u8 — strip the /hls prefix.
    handle_path /hls/* {
        reverse_proxy localhost:8888
    }
    # Self-hosted IPFS path gateway. Episodes that were pinned by the relay
    # (POST /api/v0/add to kubo on :5001) are reachable here at
    # https://media.slop.computer/ipfs/<cid>. We use `handle` (not
    # handle_path) so the /ipfs prefix is preserved — kubo's gateway
    # routes on it.
    handle /ipfs/* {
        reverse_proxy localhost:8080
    }
    # Bare-domain access still works for raw MediaMTX paths.
    reverse_proxy localhost:8888
}
