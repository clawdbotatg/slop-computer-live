# slop-computer-live reverse proxy
#
# Replace `live.slop.computer` and `media.slop.computer` with your real
# domains. Caddy auto-fetches Let's Encrypt certs on first start
# (ports 80 + 443 must be reachable).
#
# WebSockets are upgraded automatically by `reverse_proxy`.

live.slop.computer {
    encode zstd gzip

    # Relay HTTP routes (SIWE auth, admin start/stop) and WS /signal endpoint.
    # NOTE: port 8081 — :8080 is owned by based-keno on this host.
    @relay path /signal* /auth/* /admin/api/*
    reverse_proxy @relay localhost:8081

    # Next.js app
    reverse_proxy localhost:3000
}

media.slop.computer {
    encode zstd gzip
    # MediaMTX HLS output
    reverse_proxy localhost:8888
}
